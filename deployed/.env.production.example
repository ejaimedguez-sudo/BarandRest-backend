APP_NAME=BarAndRest
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_APP_KEY
APP_DEBUG=false
APP_URL=https://your-production-domain.example

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barandrest
DB_USERNAME=root
DB_PASSWORD=

# Mail (example template — replace with your provider credentials)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=reports@yourdomain.com
MAIL_FROM_NAME="BarAndRest"

# Report recipients (comma separated)
MAIL_REPORT_RECIPIENT=admin@yourdomain.com

# Queue
QUEUE_CONNECTION=database

# Security
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
