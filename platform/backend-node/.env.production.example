# Runtime
NODE_ENV=production
PORT=4100

# Database (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barandrest_platform
DB_USER=barandrest_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Security
JWT_SECRET=CHANGE_ME_64_PLUS_CHARS_RANDOM
CORS_ORIGINS=https://admin.tu-dominio.com,https://app.tu-dominio.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Client
CLIENT_BASE_URL=https://admin.tu-dominio.com

# Payments provider
# mock | stripe-like
PAYMENT_PROVIDER=stripe-like
PAYMENT_API_URL=https://api.tu-pasarela.com/v1
PAYMENT_API_KEY=CHANGE_ME_PAYMENT_API_KEY
PAYMENT_CURRENCY=MXN

# CFDI provider
# mock | api
CFDI_PROVIDER=api
CFDI_API_URL=https://api.tu-cfdi.com/v1
CFDI_API_KEY=CHANGE_ME_CFDI_API_KEY
