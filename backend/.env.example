APP_NAME="Ordena Facil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dashboard API key used by the simple dashboard endpoints
# Set a secure random value in production and add same value to the X-API-KEY header
DASHBOARD_API_KEY=change_me_to_a_secure_value

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Optional robust local mode: PostgreSQL (Docker)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ordena_facil
# DB_USERNAME=ordena_facil
# DB_PASSWORD=ordena_facil

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# Mail configuration (safe local default)
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=reports@yourdomain.com
MAIL_FROM_NAME="Ordena Facil"

# Queue
QUEUE_CONNECTION=database

# Report recipients (comma separated). Set to real emails in production.
MAIL_REPORT_RECIPIENT=admin@example.com

# Security (production recommendations)
# Set APP_ENV=production and APP_DEBUG=false in production
# Ensure APP_URL uses https:// and the APP_KEY is set


# Optional: SQS or other queue config examples
# QUEUE_CONNECTION=database

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
